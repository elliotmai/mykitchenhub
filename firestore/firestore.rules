rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile on signup
      allow create: if isOwner(userId) 
        && hasRequiredFields(['email', 'createdAt', 'preferences', 'helloFresh']);
      
      // Users can update their own profile
      allow update: if isOwner(userId)
        // Prevent changing createdAt or email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == resource.data.email;
      
      // Users cannot delete their profile (must be done through admin)
      allow delete: if false;
      
      // ============================================
      // STORAGE LOCATIONS SUBCOLLECTION
      // ============================================
      
      match /storageLocations/{locationId} {
        // Users can read their own storage locations
        allow read: if isOwner(userId);
        
        // Users can create storage locations
        allow create: if isOwner(userId)
          && hasRequiredFields(['label', 'type', 'icon', 'color', 'order', 'isDefault', 'createdAt'])
          && request.resource.data.type in ['fridge', 'freezer', 'pantry'];
        
        // Users can update their storage locations
        allow update: if isOwner(userId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.type in ['fridge', 'freezer', 'pantry'];
        
        // Users can delete their storage locations
        // Only if it's not a default location
        allow delete: if isOwner(userId) && !resource.data.isDefault;
      }
      
      // ============================================
      // INVENTORY SUBCOLLECTION
      // ============================================
      
      match /inventory/{itemId} {
        // Users can read their own inventory
        allow read: if isOwner(userId);
        
        // Users can create inventory items
        allow create: if isOwner(userId)
          && hasRequiredFields(['name', 'normalized', 'quantity', 'unit', 
                                'locationId', 'locationType', 
                                'addedAt', 'source'])
          && request.resource.data.locationType in ['fridge', 'freezer', 'pantry']
          && request.resource.data.source in ['manual', 'hellofresh', 'csv-import', 'seed']
          && request.resource.data.quantity > 0;
        
        // Users can update their inventory items
        allow update: if isOwner(userId)
          && request.resource.data.addedAt == resource.data.addedAt
          && request.resource.data.quantity >= 0;
        
        // Users can delete their inventory items
        allow delete: if isOwner(userId);
      }

      // ============================================
      // IMPORT HISTORY SUBCOLLECTION
      // ============================================

      // One record per bulk import (CSV today), written by the importer in the
      // app and by the importInventoryFromCSV Cloud Function.
      match /importHistory/{importId} {
        // Users can read their own import log
        allow read: if isOwner(userId);

        // Users can append to their own import log
        allow create: if isOwner(userId)
          && hasRequiredFields(['fileName', 'importedAt', 'itemsImported',
                                'itemsSkipped', 'status', 'source'])
          && request.resource.data.source in ['csv-import', 'hellofresh']
          && request.resource.data.status in ['completed', 'partial', 'failed']
          && request.resource.data.itemsImported >= 0
          && request.resource.data.itemsSkipped >= 0;

        // A log is a record of what happened — it is never rewritten
        allow update: if false;

        // Users can clear their own history
        allow delete: if isOwner(userId);
      }
    }
    
    // ============================================
    // RECIPES COLLECTION
    // ============================================
    
    match /recipes/{recipeId} {
      // Anyone authenticated can read recipes
      allow read: if isAuthenticated();
      
      // Users can create recipes
      allow create: if isAuthenticated()
        && hasRequiredFields(['name', 'ingredients', 'instructions', 
                              'source', 'createdAt', 'tags', 'servings', 
                              'difficulty', 'timesCooked'])
        && request.resource.data.source in ['legacy', 'spoonacular', 
                                              'ai-generated', 'user-created', 
                                              'hellofresh']
        && request.resource.data.difficulty in ['easy', 'medium', 'hard']
        && request.resource.data.servings > 0
        && request.resource.data.timesCooked >= 0;
      
      // Users can update recipes (for incrementing timesCooked, etc.)
      allow update: if isAuthenticated()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name == resource.data.name;
      
      // Only allow deletion if user created the recipe
      allow delete: if isAuthenticated() 
        && resource.data.source == 'user-created';
    }
    
    // ============================================
    // SYNC METADATA COLLECTION
    // ============================================
    
    match /syncMetadata/{metadataId} {
      // Anyone authenticated can read sync status
      allow read: if isAuthenticated();
      
      // Only cloud functions can write sync metadata
      // (This requires service account authentication)
      allow write: if false;
    }
    
    // ============================================
    // DEFAULT DENY
    // ============================================
    
    // Deny all other operations by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
