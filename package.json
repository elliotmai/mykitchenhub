{
  "name": "mykitchenhub",
  "version": "0.10.7",
  "private": true,
  "description": "Recipe & Inventory Management Progressive Web Application",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "axios": "^1.6.0",
    "bootstrap": "^5.3.2",
    "date-fns": "^2.30.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.294.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.4",
    "@types/papaparse": "^5.3.14",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.1.0",
    "serve": "^14.2.6",
    "workbox-webpack-plugin": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "scripts": {
    "prepare": "node .githooks/install.mjs",
    "start": "craco start",
    "build": "craco build && node scripts/bundle-functions.mjs",
    "eject": "react-scripts eject",
    "test": "craco test",
    "test:ci": "cross-env CI=true craco test --coverage --watchAll=false --passWithNoTests",
    "test:coverage": "cross-env CI=true craco test --coverage --watchAll=false",
    "test:tz": "cross-env CI=true TZ=America/New_York craco test --watchAll=false",
    "test:functions": "npm --prefix functions test",
    "test:rules": "npm --prefix firestore run test:rules",
    "test:e2e": "npm run build:e2e && npm run test:e2e:only",
    "test:e2e:ui": "npm run build:e2e && playwright test --ui",
    "test:all": "run-s test:ci test:functions test:rules",
    "lint": "eslint src/ e2e/ --ext .js,.jsx --max-warnings=0",
    "lint:fix": "eslint src/ e2e/ --ext .js,.jsx --fix",
    "format": "prettier --write src/ e2e/ *.js",
    "format:check": "prettier --check src/ e2e/ *.js",
    "validate": "run-s lint format:check test:ci build",
    "build:e2e": "cross-env REACT_APP_USE_EMULATORS=true REACT_APP_SUPABASE_URL=http://127.0.0.1:54321 REACT_APP_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0 REACT_APP_HIVE_ORIGIN=http://127.0.0.1:9 REACT_APP_FIREBASE_FUNCTIONS_URL=http://127.0.0.1:5001/mykitchenhub-e2e/us-central1 craco build",
    "test:e2e:only": "playwright test",
    "e2e:db:start": "npx --yes supabase@3.4.0 start --workdir e2e -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,postgres-meta,mailpit",
    "e2e:db:stop": "npx --yes supabase@3.4.0 stop --workdir e2e --no-backup",
    "e2e:db:sync": "node scripts/sync-hive-schema.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "resetMocks": false,
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/service-worker.js",
      "!src/serviceWorkerRegistration.js",
      "!src/components/FirebaseTest.jsx",
      "!src/test-utils/**",
      "!src/**/__tests__/**",
      "!src/**/*.{test,spec}.{js,jsx}"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 88,
        "branches": 78,
        "functions": 86,
        "lines": 90
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
