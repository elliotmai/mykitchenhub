# MyKitchenHub — frontend environment
#
# Copy to `.env` and fill in the values from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration
#
# `.env` is gitignored. Never commit real values, and never paste a key into a
# document, a commit message or an issue. Every variable here is inlined into
# the JavaScript bundle at build time, so treat all of them as public — the
# Firebase web API key is not a secret, it is an identifier. What actually
# protects your data is the Firestore security rules.
#
# See README.md for which of these are required and what stops working without
# the optional ones.

# ── Required: Firebase web app config ───────────────────────────────────────
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# ── Required in practice: base URL for the Cloud Functions ──────────────────
# Without it, signup falls back to creating the profile from the browser, and
# HelloFresh photo and link import are switched off.
REACT_APP_FIREBASE_FUNCTIONS_URL=https://us-central1-your-project.cloudfunctions.net

# ── Optional ────────────────────────────────────────────────────────────────
# Google Analytics 4 measurement id. Leave blank and analytics stays off.
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Set to `true` to point the app at the local Firebase emulators instead of the
# real project. Leave unset for a normal build.
# REACT_APP_USE_EMULATORS=true
